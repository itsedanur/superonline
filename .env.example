# Superonline AI Complaint Intelligence Platform Configuration
# Copy this file to .env and set your custom values for production deployment.

# Server Environment & Port Configuration
APP_ENV=development
APP_PORT=8080

# Database Configuration
# Supports SQLite (default) or PostgreSQL (when DB_TYPE=postgres)
DB_TYPE=sqlite
DATABASE_PATH=superonline_enterprise.db

# Web Prototype Access Control
ENABLE_PUBLIC_WEB_PROTOTYPE=false

# Optional LLM / OpenAI API Integration for Deep AI Categorization
# OPENAI_API_KEY=your-openai-api-key-here
# AZURE_OPENAI_KEY=your-azure-openai-key-here

# Security Secret Key
SECRET_KEY=change-me-to-a-secure-random-secret
